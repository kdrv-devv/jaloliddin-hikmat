# MongoDB Atlas ulanish satri.
# Vercel paneliga qo'yayotganda qo'shtirnoqlarsiz, faqat satrning o'zini
# yopishtiring — panel qo'shtirnoqni qiymatning bir qismi deb saqlaydi.
# Atlas → Database → Connect → Drivers bo'limidan oling.
# <db_password> o'rniga haqiqiy parolni qo'ying.
# DIQQAT: parolda $ belgisi bo'lmasin — .env fayllarida $ o'zgaruvchi deb
# o'qiladi va qiymat buziladi. @ : / ? belgilari ham ulanish satrini buzadi.
MONGODB_URI="mongodb+srv://foydalanuvchi:parol@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Baza nomi (ixtiyoriy, sukut bo'yicha "jaloliddin").
MONGODB_DB="jaloliddin"

# Sessiya kaliti — "npm run gen:secret" bilan yarating (kamida 32 belgi).
AUTH_SECRET=""

# Admin panelga kirish.
# Hashni "npm run gen:password -- 'sizning-parolingiz'" bilan yarating va
# chiqqan qatorni o'zgartirmasdan ko'chiring. Qiymat base64 ko'rinishida
# bo'ladi — chunki bcrypt hashidagi $ belgilari .env faylida yo'qoladi.
ADMIN_USERNAME="jaloliddin"
ADMIN_PASSWORD_HASH=""

# Saytning to'liq manzili — canonical, RSS, sitemap va OG teglari uchun.
# VERCEL PANELIGA QO'SHTIRNOQSIZ yozing: https://jaloliddinhikmat.uz
# (qo'shtirnoq bilan yozilsa, avval butun saytdagi manzillar buzilardi;
# hozir kod uni o'zi tozalaydi, lekin baribir toza yozilgani ma'qul.)
# Bo'sh qoldirilsa "https://jaloliddinhikmat.uz" ishlatiladi.
NEXT_PUBLIC_SITE_URL="https://jaloliddinhikmat.uz"

# Google Search Console tasdiqlash kodi (ixtiyoriy).
# Search Console → Sozlamalar → Egalikni tasdiqlash → "HTML tegi" usulini
# tanlang va <meta name="google-site-verification" content="BU-YER"> dagi
# faqat content qiymatini shu yerga qo'ying. Domenni DNS orqali tasdiqlagan
# bo'lsangiz, bu kerak emas.
GOOGLE_SITE_VERIFICATION=""

# Yandex Webmaster tasdiqlash kodi (ixtiyoriy) — O'zbekistonda Yandex ulushi
# sezilarli, shuning uchun saytni u yerga ham qo'shish foydali.
YANDEX_VERIFICATION=""
